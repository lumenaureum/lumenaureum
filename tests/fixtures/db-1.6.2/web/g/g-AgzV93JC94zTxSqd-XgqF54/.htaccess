Options -Indexes
<FilesMatch "^(seen\.(txt|key)|seen-key\.php|seen-at\.php|sealed\.php|offer-kid\.php|tries\.php|limits\.(txt|php)|once\.(txt|php)|done\.(txt|php)|(picks|draft)(-[0-9a-f]{16})?\.(las|bin).*|[0-9a-f]{24}\.las.*)$">
  Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^orders(/|$) - [F,L]
RewriteRule ^([0-9a-f]{24}\.bin|manifest\.bin|offer\.bin)$ gate.php?f=$1 [L]
<IfModule mod_headers.c>
  Header set Referrer-Policy "no-referrer"
  Header set X-Robots-Tag "noindex, nofollow"
  Header set X-Content-Type-Options "nosniff"
  <FilesMatch "^(index\.html|font(-light)?\.woff2)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
